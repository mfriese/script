#include <metal_stdlib>
using namespace metal;

struct VertexInput {
    float2 uv [[attribute(0)]];
};

struct Camera {
    float4x4 clipFromWorld;
};

struct VertexOutput {
    float4 position [[position]];
    float3 worldPosition [[user(locn0)]];
};

vertex VertexOutput terrain_vertex(
    VertexInput input [[stage_in]],
    texture2d<float> heightmap [[texture(0)]],
    sampler heightmapSampler [[sampler(0)]],
    constant Camera& camera [[buffer(0)]]) {
    VertexOutput output;
    // Die Graustufe der Canyon-Heightmap definiert die Gelände-Höhe.
    const float height = heightmap.sample(heightmapSampler, input.uv, level(0)).r * 22.0;
    const float3 world = float3((input.uv.x - .5) * 100.0, height, (input.uv.y - .5) * 100.0);
    output.position = camera.clipFromWorld * float4(world, 1.0);
    output.worldPosition = world;
    return output;
}
